# Скопируйте значения в .env в корне репозитория (его читает npm run support:dev).
# Файл .env в git не попадает. Настоящие токен и пароль сюда не пишите.

# Та же база, что у бота обмена. Процесс поддержки только читает заявки.
DATABASE_URL=postgresql://changenow:CHANGE_ME@127.0.0.1:5432/changenow?schema=public

# Токен второго бота от @BotFather, формат "<id бота>:<секрет>".
SUPPORT_BOT_TOKEN=

# Пароль, который админ пишет этому боту. Длинная случайная строка.
# В истории чата Telegram пароль останется. В логи процесс его не пишет.
SUPPORT_ADMIN_PASSWORD=
