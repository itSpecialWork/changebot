# Скопируйте в .env и замените значения CHANGE_ME на свои.
# Файл .env не должен попадать в git.

# --- Приложение ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Таймаут graceful shutdown в миллисекундах
SHUTDOWN_TIMEOUT_MS=10000

# --- Telegram-бот ---
# Токен от @BotFather, формат "<id бота>:<секрет>". Только в .env, в git не попадает.
# Без токена запускается лишь HTTP-сервер: бот и фоновые worker'ы отключены.
# Если токен когда-либо попал в чат, скриншот или репозиторий — перевыпустите его
# у @BotFather (/revoke) и обновите значение здесь.
TELEGRAM_BOT_TOKEN=

# --- PostgreSQL (используется docker-compose.yml) ---
POSTGRES_USER=changenow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=changenow
POSTGRES_PORT=5432

# --- Подключение приложения и Prisma к PostgreSQL ---
# Значения user/password/db/port должны совпадать с POSTGRES_* выше.
# Если пароль содержит спецсимволы, закодируйте его (URL-encoding).
DATABASE_URL=postgresql://changenow:CHANGE_ME@127.0.0.1:5432/changenow?schema=public

# --- ChangeNOW API v2 ---
# По умолчанию выключено: бот использует тестовый провайдер в памяти
# (четыре вымышленные валюты и кнопка «Демо: следующий статус»).
# true — живой каталог, котировки и создание обмена. Подтверждение в боте
# создаёт заявку у ChangeNOW и показывает адрес депозита: средства отправляете вы.
# Ключ только в этом файле. В git он не попадает. Не логируется.
# Включённый флаг без ключа — ошибка запуска, тихого отката на тест нет.
# Вернуть тест: CHANGENOW_ENABLED=false и перезапуск.
CHANGENOW_ENABLED=false
CHANGENOW_API_KEY=

# --- Страница виджета ---
# GET /widget — рамка виджета ChangeNOW и скрипт следующего шага.
# Кнопка «Открыть обмен» открывает эту страницу в браузере.
# Без адреса ниже это http://127.0.0.1:<PORT>/widget
# Публичный https без пути, например https://exchange.example.com,
# нужен, чтобы ту же страницу открывали не с этой машины.
PUBLIC_BASE_URL=

# --- Интеграционные тесты схемы БД (необязательно) ---
# Отдельная БД, имя которой оканчивается на _test (создаётся вручную:
# CREATE DATABASE changenow_test). Без этой переменной tests/db пропускаются.
# TEST_DATABASE_URL=postgresql://changenow:CHANGE_ME@127.0.0.1:5432/changenow_test?schema=public

# --- Бот поддержки (отдельный процесс, свой токен) ---
# Тот же файл .env. Пример полей: support-bot/.env.example.
# Пустой токен не даёт поднять контейнер поддержки.
SUPPORT_BOT_TOKEN=
# Длинная случайная строка. В чат и в git не попадает.
SUPPORT_ADMIN_PASSWORD=

# --- Копия базы на сервере (scripts/backup-db.sh) ---
# Пустое значение: файл только в /var/backups/changenow.
# Позже: s3://bucket/prefix или user@другой-сервер:/каталог
# В значении не должно быть пробелов.
BACKUP_TARGET=
